# Copy this file to `.env.local` and fill in real values. Never commit `.env.local`.

# --- Database (Railway Postgres) ---
# Connection string from the Railway Postgres service (Variables/Connect tab).
DATABASE_URL="postgresql://user:password@host:5432/railway"
# Optional: a non-pooled endpoint if you use one. Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=""

# --- Multi-tenant routing ---
# Root domain that serves free tenant subdomains, e.g. "fieldpie.site".
NEXT_PUBLIC_ROOT_DOMAIN="fieldpie.site"

# --- Object storage (S3-compatible; e.g. Neon Object Storage) ---
AWS_ENDPOINT_URL_S3=""
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET=""

# --- Cloudflare for SaaS (custom hostnames) — used in Phase 2 ---
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""

# --- FieldPie integration (optional prefill + lead creation) ---
FIELDPIE_API_BASE_URL=""
FIELDPIE_API_TOKEN=""

# --- AI content generation — used in Phase 1.5 (e.g. Neon AI Gateway) ---
AI_GATEWAY_BASE_URL=""
OPENAI_API_KEY=""
