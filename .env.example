# Copy this file to `.env.local` and fill in real values. Never commit `.env.local`.

# --- Database (Neon Postgres) ---
# Pooled connection string used by the app at runtime.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Direct (non-pooled) connection string used by drizzle-kit for migrations.
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# --- Multi-tenant routing ---
# Root domain that serves free tenant subdomains, e.g. "fieldpie.site".
NEXT_PUBLIC_ROOT_DOMAIN="fieldpie.site"

# --- Object storage (S3-compatible) ---
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Cloudflare for SaaS (custom hostnames) — used in Phase 2 ---
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""

# --- FieldPie integration (optional prefill + lead creation) ---
FIELDPIE_API_BASE_URL=""
FIELDPIE_API_TOKEN=""

# --- AI content generation — used in Phase 1.5 ---
AI_PROVIDER=""
AI_API_KEY=""
